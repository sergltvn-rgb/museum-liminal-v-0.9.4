## Затемнить или осветлить цвет палитры на долю [-1..1].
##
## Нужно там, где одному предмету требуется несколько ступеней одного
## материала (кромка ящика темнее его боковины). Так модуль остаётся внутри
## палитры вместо того, чтобы вписать рядом новый литерал.
static func tone(base: Color, amount: float) -> Color:
	if amount >= 0.0:
		return base.lightened(clampf(amount, 0.0, 1.0))
	return base.darkened(clampf(-amount, 0.0, 1.0))


## Сдвинуть цвет к другому цвету палитры на долю [0..1].
##
## Для случаев вроде "та же сталь, но с зеленцой от аварийной лампы":
## смешивание двух канонических цветов остаётся в каноне, а произвольный
## подобранный на глаз оттенок — уже нет.
static func mixed(base: Color, towards: Color, amount: float) -> Color:
	return base.lerp(towards, clampf(amount, 0.0, 1.0))
