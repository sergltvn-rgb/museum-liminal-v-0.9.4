# Godot 4: per-machine cache, never commit or archive this directory.
# It is rebuilt automatically and was 142 MB of the 175 MB museum-liminal.rar.
.godot/

# OS junk
.DS_Store
Thumbs.db

# Archives and temporary exports
*.rar
*.zip
*.tmp
export/
build/
*.pck

# Node dependencies (notion_worker and any future tooling).
# Also kept out of the Godot import scan by notion_worker/.gdignore.
node_modules/

# Agent worktrees: a full duplicate checkout of this repository.
# Was previously hidden only by the machine-local .git/info/exclude,
# so a fresh clone would have started tracking it.
/.claude/worktrees/

# Secrets. The ElevenLabs key (and anything like it) lives here, never in the
# repository and never pasted into a source file.
.env
.env.*
!.env.example

# Python bytecode cache from tools/ (check_localization.py and friends).
__pycache__/
*.pyc

# Machine-local MCP bridge: the launcher, its batch file and the wrapper it
# spawns. All three hardcode this machine's Godot path (C:\Users\litvi\...),
# so they are useless to anyone else and noisy in every diff.
start-mcp.cjs
start-mcp.cmd
bypass-wrapper.cjs
.mcp.json

# Assistant session logs (claude/): tens of MB of JSONL transcripts and
# per-subagent dumps. Useful locally for post-mortems, worthless in history.
claude/

# Local MCP runtime logs.
bridge.stdout.log
bridge.stderr.log
bypass-wrapper-rpc.log
proxy.log

# Agent screenshots. Regenerated on demand by game/test_shot.gd and the
# *_capture.gd suites; they are review artefacts, not sources. Keeping them in
# history means a new JPEG set on every visual iteration.
shots/
lobby_captures/
exterior_captures/
drive_captures/
facade_captures/

# Scratch scripts written by agents mid-session (tmp_cut.py, tmp_probe.py,
# tmp_length.gd and friends). Real tooling goes in tools/ without the prefix.
tools/tmp_*

# Qoder IDE workspace metadata, same class as .claude/.
.qoder/

# TerraBrush: GDExtension .dll that does not load in this project (it errors on
# --import) and the terrain is procedural anyway. Kept on disk so the editor
# stops asking, excluded from history so nobody ships a broken binary addon.
addons/terrabrush/
 
# уменьшенные копии референсов для просмотра агентом 
references/**/small/ 
